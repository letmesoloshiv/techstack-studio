# --- Google Gemini (default when VITE_AI_PROVIDER is not groq) ---
# Key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional model (default: gemini-2.0-flash). If free tier is exhausted, switch provider below instead.
# VITE_GEMINI_MODEL=gemini-2.0-flash-lite

# --- Groq (recommended when Gemini free quota hits "limit: 0") ---
# Free API key: https://console.groq.com — uses Llama / Mixtral; separate limits from Google.
# VITE_AI_PROVIDER=groq
# VITE_GROQ_API_KEY=your_groq_api_key_here
# Optional — default llama-3.3-70b-versatile
# VITE_GROQ_MODEL=llama-3.1-8b-instant
